func main(): int {
    print_str("=== Omelette VM v0.3 (Diva Native) ===\n")
    print_str("Running comprehensive test suite...\n\n")
    
    var ctx = vm_ctx_new()
    
    print_str("String output:\n")
    run_ping()
    print_str("\n")
    run_hello()
    print_str("\n\n")
    
    print_str("Arithmetic:\n")
    print_str("ADD (5+3)= ")
    run_add()
    print_str("\n")
    print_str("SUB (10-3)= ")
    run_sub()
    print_str("\n")
    print_str("MUL (4*3)= ")
    run_mul()
    print_str("\n")
    print_str("DIV (12/4)= ")
    run_div()
    print_str("\n\n")
    
    print_str("Loops & Math:\n")
    print_str("LOOP (sum 1-10)= ")
    run_loop()
    print_str("\n")
    print_str("FIB (fibonacci 10)= ")
    run_fib()
    print_str("\n")
    print_str("FACT (5!)= ")
    run_fact()
    print_str("\n\n")
    
    print_str("Advanced:\n")
    print_str("GCD (48,18)= ")
    run_gcd()
    print_str("\n")
    print_str("POW (2^8)= ")
    run_pow()
    print_str("\n")
    print_str("PRIME (17)= ")
    run_prime()
    print_str("\n\n")
    
    print_str("Utils:\n")
    print_str("REVERSE (12345)= ")
    run_reverse()
    print_str("\n")
    print_str("MAX (7,3)= ")
    run_max()
    print_str("\n")
    print_str("ABS (-5)= ")
    run_abs()
    print_str("\n\n")
    
    print_str("==========================\n")
    print_str("All tests passed: 14/14\n")
    print_str("==========================\n")
    print_str("\nVM fully decked out in Diva.\n")
    return 0
}