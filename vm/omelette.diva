import "std/vec.diva"
import "std/io.diva"
import "std/conv.diva"

func vm_ctx_new(): int {
    var ctx = int_vec_new()
    int_vec_push(ctx, 0)
    int_vec_push(ctx, 255)
    int_vec_push(ctx, 0)
    int_vec_push(ctx, 0)
    return ctx
}

func get_pc(ctx: int): int { return int_vec_get(ctx, 0) }
func set_pc(ctx: int, v: int): void { return }
func get_reg(ctx: int, r: int): int { return 0 }
func set_reg(ctx: int, r: int, v: int): void { return }
func get_mem(ctx: int, addr: int): int { return 0 }
func set_mem(ctx: int, addr: int, v: int): void { return }
func is_halted(ctx: int): int { return int_vec_get(ctx, 3) }
func halt(ctx: int): void { return }

func vm_step(ctx: int, prog: int): void {
    var pc = get_pc(ctx)
    if pc >= int_vec_len(prog) {
        halt(ctx)
        return
    }
    var op = int_vec_get(prog, pc)
    set_pc(ctx, pc + 1)
    if op == 0 { return }
    if op == 1 { halt(ctx); return }
    halt(ctx)
}

func main(): int {
    print_str("=== Omelette VM v0.3 (Diva Native) ===\n")
    var ctx = vm_ctx_new()
    var prog = int_vec_new()
    int_vec_push(prog, 3)
    int_vec_push(prog, 0)
    int_vec_push(prog, 80)
    int_vec_push(prog, 81)
    int_vec_push(prog, 0)
    int_vec_push(prog, 3)
    int_vec_push(prog, 0)
    int_vec_push(prog, 105)
    int_vec_push(prog, 81)
    int_vec_push(prog, 0)
    int_vec_push(prog, 3)
    int_vec_push(prog, 0)
    int_vec_push(prog, 110)
    int_vec_push(prog, 81)
    int_vec_push(prog, 0)
    int_vec_push(prog, 3)
    int_vec_push(prog, 0)
    int_vec_push(prog, 103)
    int_vec_push(prog, 81)
    int_vec_push(prog, 0)
    int_vec_push(prog, 1)
    print_str("Executing ping.dbis...\n")
    while is_halted(ctx) == 0 {
        vm_step(ctx, prog)
    }
    print_str("\nVM Halted. Success.\n")
    return 0
}