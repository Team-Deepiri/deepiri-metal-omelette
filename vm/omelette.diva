func is_halted(ctx: int): int {
    return 0
}

func set_halted(ctx: int, v: int): void {
    return
}

func halt(ctx: int): void {
    set_halted(ctx, 1)
    return
}

func vm_step(ctx: int, prog: int): void {
    var pc = get_pc(ctx)
    set_pc(ctx, pc + 1)
    if pc == 0 { halt(ctx) }
    return
}

