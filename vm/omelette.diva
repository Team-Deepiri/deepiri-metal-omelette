extern func print_int(x: int): void
extern func print_str(x: str): void

func main(): int {
    print_str("=== DBIS VM v0.3 - Test Suite ===\n\n")
    
    print_str("String output:\n")
    print_str("PING: Ping!\n")
    print_str("HELLO: Hello World!\n")
    
    print_str("\nArithmetic:\n")
    print_str("ADD (5+3): ")
    print_int(5 + 3)
    print_str("\n")
    
    print_str("SUB (10-3): ")
    print_int(10 - 3)
    print_str("\n")
    
    print_str("MUL (4*3): ")
    print_int(4 * 3)
    print_str("\n")
    
    print_str("DIV (12/4): ")
    print_int(12 / 4)
    print_str("\n")
    
    print_str("\nLoops & Math:\n")
    
    print_str("LOOP (sum 1-10): ")
    let sum = 0
    let i = 1
    while i <= 10 {
        sum = sum + i
        i = i + 1
    }
    print_int(sum)
    print_str("\n")
    
    print_str("FIB (10): ")
    let n = 10
    let a = 0
    let b = 1
    let j = 2
    while j <= n {
        let tmp = a + b
        a = b
        b = tmp
        j = j + 1
    }
    print_int(b)
    print_str("\n")
    
    print_str("FACT (5): ")
    let fn = 5
    let result = 1
    while fn > 1 {
        result = result * fn
        fn = fn - 1
    }
    print_int(result)
    print_str("\n")
    
    print_str("GCD (48,18): ")
    let ga = 48
    let gb = 18
    while ga - gb != 0 {
        if ga > gb { ga = ga - gb }
        else { gb = gb - ga }
    }
    print_int(ga)
    print_str("\n")
    
    print_str("POW (2^8): ")
    let base = 2
    let exp = 8
    let pow = 1
    while exp > 0 {
        pow = pow * base
        exp = exp - 1
    }
    print_int(pow)
    print_str("\n")
    
    print_str("PRIME (17): ")
    let pn = 17
    let prime = 1
    let pi = 2
    while pi * pi <= pn {
        if pn - (pn / pi) * pi == 0 { prime = 0 }
        pi = pi + 1
    }
    if prime == 1 { print_str("yes") }
    else { print_str("no") }
    print_str("\n")
    
    print_str("REVERSE (12345): ")
    let rn = 12345
    let rev = 0
    while rn > 0 {
        let d = rn - (rn / 10) * 10
        rev = rev * 10 + d
        rn = rn / 10
    }
    print_int(rev)
    print_str("\n")
    
    print_str("MAX (7,3): ")
    let x = 7
    let y = 3
    if x >= y { print_int(x) }
    else { print_int(y) }
    print_str("\n")
    
    print_str("ABS (-5): ")
    let neg = 0 - 5
    if neg < 0 { neg = 0 - neg }
    print_int(neg)
    print_str("\n")
    
    print_str("COUNTDIGITS (12345): ")
    let cd = 12345
    let count = 0
    while cd > 0 {
        count = count + 1
        cd = cd / 10
    }
    print_int(count)
    print_str("\n")
    
    print_str("\n=== All tests complete ===\n")
    return 0
}
