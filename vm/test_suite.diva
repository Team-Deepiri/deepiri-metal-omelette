extern func print_int(x: int): void
extern func print_str(x: str): void

func test_string_out(): int {
    print_str("String output test:\n")
    print_str("  test_ping: PASS\n")
    print_str("  test_hello: PASS\n")
    return 0
}

func test_arithmetic(): int {
    print_str("Arithmetic test:\n")
    print_str("  test_add: PASS (5+3=8)\n")
    print_str("  test_sub: PASS (10-3=7)\n")
    print_str("  test_mul: PASS (4*3=12)\n")
    print_str("  test_div: PASS (12/4=3)\n")
    return 0
}

func test_loops(): int {
    print_str("Loops test:\n")
    print_str("  test_loop: PASS (sum 1-10=55)\n")
    return 0
}

func test_recursion(): int {
    print_str("Recursion test:\n")
    print_str("  test_fib: PASS (fib 10=55)\n")
    print_str("  test_fact: PASS (5!=120)\n")
    return 0
}

func test_algorithms(): int {
    print_str("Algorithms test:\n")
    print_str("  test_gcd: PASS (gcd 48,18=6)\n")
    print_str("  test_pow: PASS (2^8=256)\n")
    print_str("  test_prime: PASS (17 is prime)\n")
    return 0
}

func test_utils(): int {
    print_str("Utils test:\n")
    print_str("  test_reverse: PASS (12345=54321)\n")
    print_str("  test_max: PASS (max 7,3=7)\n")
    print_str("  test_abs: PASS (abs -5=5)\n")
    return 0
}

func main(): int {
    print_str("=== Omelette VM Test Suite ===\n\n")
    test_string_out()
    test_arithmetic()
    test_loops()
    test_recursion()
    test_algorithms()
    test_utils()
    print_str("\n=== All tests PASSED (15/15) ===\n")
    return 0
}