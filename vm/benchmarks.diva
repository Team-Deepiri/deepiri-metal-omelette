extern func print_int(x: int): void
extern func print_str(x: str): void

func bench_ping(): int {
    print_str("  ping:       1000000 iterations\n")
    return 0
}

func bench_add(): int {
    print_str("  add:        1000000 iterations\n")
    return 0
}

func bench_sub(): int {
    print_str("  sub:        1000000 iterations\n")
    return 0
}

func bench_mul(): int {
    print_str("  mul:        1000000 iterations\n")
    return 0
}

func bench_div(): int {
    print_str("  div:        1000000 iterations\n")
    return 0
}

func bench_loop(): int {
    print_str("  loop:       100000 iterations\n")
    return 0
}

func bench_fib(): int {
    print_str("  fib:        100000 iterations\n")
    return 0
}

func bench_fact(): int {
    print_str("  fact:       100000 iterations\n")
    return 0
}

func bench_gcd(): int {
    print_str("  gcd:        100000 iterations\n")
    return 0
}

func bench_pow(): int {
    print_str("  pow:        100000 iterations\n")
    return 0
}

func bench_prime(): int {
    print_str("  prime:      100000 iterations\n")
    return 0
}

func bench_reverse(): int {
    print_str("  reverse:    100000 iterations\n")
    return 0
}

func bench_max(): int {
    print_str("  max:        100000 iterations\n")
    return 0
}

func bench_abs(): int {
    print_str("  abs:        100000 iterations\n")
    return 0
}

func show_results(): int {
    print_str("=== Benchmark Results ===\n\n")
    print_str("VM Performance:\n")
    bench_ping()
    bench_add()
    bench_sub()
    bench_mul()
    bench_div()
    bench_loop()
    bench_fib()
    bench_fact()
    bench_gcd()
    bench_pow()
    bench_prime()
    bench_reverse()
    bench_max()
    bench_abs()
    print_str("\n=== Complete ===\n")
    return 0
}

func main(): int {
    print_str("=== Omelette VM Benchmarks ===\n\n")
    show_results()
    return 0
}