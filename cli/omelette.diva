extern func print_int(x: int): void
extern func print_str(x: str): void

func main(): int {
    print_str("=== deepiri-metal-omelette CLI ===\n")
    print_str("DBIS v0.3 - All in Diva\n\n")
    
    print_str("Usage:\n")
    print_str("  diva run vm/omelette.diva   - Run VM with tests\n")
    print_str("  diva run cli/omelette.diva - Show this help\n\n")
    
    print_str("Example programs (.dbis):\n")
    print_str("  ping.dbis       - Print 'Ping'\n")
    print_str("  add.dbis       - Add 5+3=8\n")
    print_str("  fib.dbis       - Fibonacci(10)=55\n")
    print_str("  factorial.dbis - 5! = 120\n")
    print_str("  gcd.dbis       - GCD(48,18)=6\n")
    print_str("  prime.dbis     - Check if prime\n\n")
    
    print_str("VM Test Suite:\n")
    print_str("  String: PING, HELLO\n")
    print_str("  Math: ADD, SUB, MUL, DIV\n")
    print_str("  Algo: FIB, FACT, GCD, POW\n")
    print_str("  Utils: PRIME, REVERSE, MAX, ABS\n\n")
    
    print_str("DBIS v0.3 Opcodes:\n")
    print_str("  0x00 NOP   0x01 HALT  0x03 MOVI  0x10 ADD\n")
    print_str("  0x11 SUB   0x12 MUL   0x13 DIV   0x20 CMP\n")
    print_str("  0x30 JMP   0x31 JZ    0x32 JNZ  0x37 CALL\n")
    print_str("  0x38 RET   0x40 PUSH  0x41 POP   0x50 IN\n")
    print_str("  0x51 OUT\n\n")
    
    print_str("=== Ready ===\n")
    return 0
}
