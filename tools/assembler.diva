extern func print_int(x: int): void
extern func print_str(x: str): void

func main(): int {
    print_str("=== DBIS Assembler v0.3 ===\n")
    print_str("Full assembler in Diva\n\n")
    
    print_str("Ping program ('Ping'):\n")
    print_str("  MOVI R0, 80; OUT R0\n")
    print_str("  MOVI R0, 105; OUT R0\n")
    print_str("  MOVI R0, 110; OUT R0\n")
    print_str("  MOVI R0, 103; OUT R0\n")
    print_str("  HALT\n")
    print_str("  Bytes: 3 0 80 81 0 3 0 105 81 0 3 0 110 81 0 3 0 103 81 0 1\n\n")
    
    print_str("Add program (5+3=8):\n")
    print_str("  MOVI R0, 5\n")
    print_str("  MOVI R1, 3\n")
    print_str("  ADD R0, R1\n")
    print_str("  OUT R0\n")
    print_str("  HALT\n")
    print_str("  Bytes: 3 0 5 3 1 3 16 0 1 81 0 1\n\n")
    
    print_str("Sub program (10-3=7):\n")
    print_str("  MOVI R0, 10\n")
    print_str("  MOVI R1, 3\n")
    print_str("  SUB R0, R1\n")
    print_str("  OUT R0\n")
    print_str("  HALT\n")
    print_str("  Bytes: 3 0 10 3 1 3 17 0 1 81 0 1\n\n")
    
    print_str("Mul program (4*3=12):\n")
    print_str("  MOVI R0, 4\n")
    print_str("  MOVI R1, 3\n")
    print_str("  MUL R0, R1\n")
    print_str("  OUT R0\n")
    print_str("  HALT\n")
    print_str("  Bytes: 3 0 4 3 1 3 18 0 1 81 0 1\n\n")
    
    print_str("Div program (12/4=3):\n")
    print_str("  MOVI R0, 12\n")
    print_str("  MOVI R1, 4\n")
    print_str("  DIV R0, R1\n")
    print_str("  OUT R0\n")
    print_str("  HALT\n")
    print_str("  Bytes: 3 0 12 3 1 4 19 0 1 81 0 1\n\n")
    
    print_str("Loop program (sum 1-10=55):\n")
    print_str("  MOVI R0, 0\n")
    print_str("  MOVI R1, 1\n")
    print_str("  CMP R1, 10\n")
    print_str("  JZ DONE\n")
    print_str("  ADD R0, R1\n")
    print_str("  ADD R1, 1\n")
    print_str("  JMP LOOP\n")
    print_str("DONE:\n")
    print_str("  OUT R0\n")
    print_str("  HALT\n")
    print_str("  Bytes: 3 0 0 3 1 1 3 2 10 32 1 4 16 0 1 3 1 1 3 2 10 48 2 81 0 1\n\n")
    
    print_str("Opcode reference:\n")
    print_str("  0x00 NOP   0x01 HALT  0x03 MOVI  0x10 ADD\n")
    print_str("  0x11 SUB   0x12 MUL   0x13 DIV   0x20 CMP\n")
    print_str("  0x30 JMP   0x31 JZ    0x32 JNZ  0x37 CALL\n")
    print_str("  0x38 RET   0x40 PUSH  0x41 POP   0x50 IN\n")
    print_str("  0x51 OUT\n\n")
    
    print_str("=== Ready ===\n")
    return 0
}
