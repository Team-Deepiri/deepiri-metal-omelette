extern func print_int(x: int): void
extern func print_str(x: str): void

func op_code(name: str): int {
    if name == "NOP" { return 0 }
    if name == "HALT" { return 1 }
    if name == "MOV" { return 2 }
    if name == "MOVI" { return 3 }
    if name == "ADD" { return 16 }
    if name == "SUB" { return 17 }
    if name == "MUL" { return 18 }
    if name == "DIV" { return 19 }
    if name == "JMP" { return 32 }
    if name == "JZ" { return 33 }
    if name == "JNZ" { return 34 }
    if name == "CALL" { return 55 }
    if name == "RET" { return 56 }
    if name == "PUSH" { return 64 }
    if name == "POP" { return 65 }
    if name == "IN" { return 80 }
    if name == "OUT" { return 81 }
    return 0
}

func reg_num(s: str): int {
    if s == "R0" { return 0 }
    if s == "R1" { return 1 }
    if s == "R2" { return 2 }
    if s == "R3" { return 3 }
    if s == "R4" { return 4 }
    if s == "R5" { return 5 }
    if s == "R6" { return 6 }
    if s == "R7" { return 7 }
    if s == "R8" { return 8 }
    if s == "R9" { return 9 }
    if s == "R10" { return 10 }
    if s == "R11" { return 11 }
    if s == "R12" { return 12 }
    if s == "R13" { return 13 }
    if s == "R14" { return 14 }
    if s == "R15" { return 15 }
    return 0
}

func put_hex(b: int): void {
    if b < 10 { print_str("0") print_int(b) }
    if b == 10 { print_str("0A") }
    if b == 11 { print_str("0B") }
    if b == 12 { print_str("0C") }
    if b == 13 { print_str("0D") }
    if b == 14 { print_str("0E") }
    if b == 15 { print_str("0F") }
}

func main(): int {
    print_str("=== DBIS Assembler v0.1 ===\n")
    print_str("Format: OPCODE [REG] [VALUE]\n\n")
    print_str("Opcodes:\n")
    print_str("  0x00 NOP   - No operation\n")
    print_str("  0x01 HALT  - Stop\n")
    print_str("  0x03 MOVI  - Move immediate\n")
    print_str("  0x10 ADD   - Add\n")
    print_str("  0x11 SUB   - Subtract\n")
    print_str("  0x12 MUL   - Multiply\n")
    print_str("  0x13 DIV   - Divide\n")
    print_str("  0x20 JMP   - Jump\n")
    print_str("  0x21 JZ    - Jump if zero\n")
    print_str("  0x22 JNZ   - Jump if not zero\n")
    print_str("  0x37 CALL  - Call\n")
    print_str("  0x38 RET   - Return\n")
    print_str("  0x40 PUSH  - Push\n")
    print_str("  0x41 POP   - Pop\n")
    print_str("  0x50 IN    - Input\n")
    print_str("  0x51 OUT   - Output\n")
    print_str("\nExample: MOVI R0, 65 OUT R0 HALT\n")
    print_str("=== Ready ===\n")
    return 0
}